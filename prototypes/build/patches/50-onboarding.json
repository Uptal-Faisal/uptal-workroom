  "old": "<!-- blocklist -->\n<section class=\"scr\" data-scr=\"blocklist\">\n  <div class=\"back\" data-go=\"profile\"><i class=\"ti ti-arrow-left\"></i></div>\n  <div class=\"setup\"><div class=\"bar\"><i style=\"width:96%\"></i></div><div class=\"lab\"><span data-t=\"setup3b\">Step 3 of 3</span><b>96%</b></div></div>\n  <div class=\"body nonav\">\n    <div class=\"lenschip\"><i class=\"ti ti-bulb\"></i><div><b>Smart Defaults + trust.</b> <span data-t=\"lensBlock\">We seed the do-not-apply list with the current employer from the CV, so a discreet job seeker is protected by default instead of having to remember.</span></div></div>\n    <h2 class=\"h2\" data-t=\"blH\">Add the employers you do not want us to apply to.</h2>\n    <p class=\"mut mt6\" data-t=\"blSub\">We will never apply to these employers. We added your current one.</p>\n    <div class=\"card mt18\">\n      <div class=\"rowline\"><div class=\"ic\" style=\"color:var(--red)\"><i class=\"ti ti-ban\"></i></div><div class=\"tx\"><b>Acme Financial</b><span data-t=\"blCur\">Your current employer</span></div><i class=\"ti ti-x chev\"></i></div>\n      <div class=\"rowline\"><div class=\"ic\" style=\"color:var(--red)\"><i class=\"ti ti-ban\"></i></div><div class=\"tx\"><b>Acme Capital</b><span data-t=\"blSub2\">A subsidiary we detected</span></div><i class=\"ti ti-x chev\"></i></div>\n    </div>\n    <button class=\"btn btn-o mt14\"><i class=\"ti ti-plus\"></i> <span data-t=\"blAdd\">Add another employer to block</span></button>\n    <div class=\"warn mt14\"><i class=\"ti ti-shield-lock\"></i><div data-t=\"blNote\">Recruiters only see the CV we send, and never know that AI applied on your behalf.</div></div>\n  </div>\n  <div class=\"cta\"><button class=\"btn btn-b\" data-go=\"wall\"><span data-t=\"blCta\">Continue</span></button></div>\n</section>",
