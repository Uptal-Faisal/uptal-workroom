h\">Riyadh</option><option data-t=\"cJeddah\">Jeddah</option><option data-t=\"cDammam\">Dammam</option><option data-t=\"cKhobar\">Al Khobar</option><option data-t=\"cMecca\">Mecca</option><option data-t=\"cMedina\">Medina</option><option data-t=\"cAbha\">Abha</option><option data-t=\"pfNatOther\">Other</option></select></div>\n      </div>\n    </div>\n        <div class=\"setcard\" id=\"pfCardVisa\">\n      <div class=\"setcard-h\">\n        <span class=\"setcard-ic\"><i class=\"ti ti-id\"></i></span>\n        <div class=\"setcard-ht\"><span class=\"setcard-t\" data-t=\"pfVisa\">Visa and Iqama status</span></div>\n        \n      </div>\n      <hr class=\"setcard-div\">\n      <div class=\"chipgrid\" style=\"display:block\">\n        <select class=\"inp\" data-pfsel=\"visa\" data-pfreqsel=\"visa\">\n          <option value=\"\" selected data-t=\"pfVisaPick\">Choose your status</option>\n          <option data-t=\"pfVisaTrans\">Iqama, transferable</option>\n          <option data-t=\"pfVisaNon\">Iqama, not transferable</option>\n          <option data-t=\"pfVisaPrem\">Premium residency</option>\n          <option data-t=\"pfVisaGcc\">GCC national</option>\n          <option data-t=\"pfVisaNeed\">Needs a new visa</option>\n        </select>\n      </div>\n    </div>\n<div class=\"setcard\">\n      <div class=\"setcard-h\">\n        <span class=\"setcard-ic\"><i class=\"ti ti-coin\"></i></span>\n        <div class=\"setcard-ht\"><span class=\"setcard-t\" data-t=\"pfSalary\">Salary, SAR a month</span></div>\n      </div>\n      <hr class=\"setcard-div\">\n      <div class=\"chipgrid\" id=\"pfSalGrid\" style=\"display:grid;grid-template-columns:1fr 1fr;gap:10px\">\n        <div id=\"pfCurSal\"><div class=\"mut\" style=\"font-size:12px;font-weight:700;margin-bottom:6px\" data-t=\"pfSalCur\">Current</div><input class=\"inp filled\" value=\"26,000\" inputmode=\"numeric\" dir=\"ltr\"></div>\n        <div><div class=\"mut\" style=\"font-size:12px;font-weight:700;margin-bottom:6px\" data-t=\"pfSalExp\">Expected</div><input class=\"inp filled\" value=\"34,000\" inputmode=\"numeric\" dir=\"ltr\"></div>\n      </div>\n      \n    </div>\n  </div>\n  <div class=\"cta\"><button class=\"btn btn-b dis\" id=\"pfCtaBtn\" data-go=\"blocklist\"><span data-t=\"pfCta\">Save and continue</span></button></div>\n</section>",
  "new": "<!-- profile: about you (v6: after payment, tailored to what applications in the target markets ask) -->\n<section class=\"scr\" data-scr=\"profile\">\n  <div class=\"back\" data-go=\"rights\"><i class=\"ti ti-arrow-left\"></i></div>\n  <div class=\"setup\"><div class=\"bar\"><i style=\"width:33%\" data-ob6bar></i></div><div class=\"lab\"><span data-ob6step=\"profile\"></span><b data-ob6pct>33%</b></div></div>\n  <div class=\"body nonav\">\n    <div class=\"lenschip\"><i class=\"ti ti-bulb\"></i><div><b>Effort once, reused forever.</b> <span data-t=\"ob6LensProfile\"></span></div></div>\n    <h2 class=\"h2\" data-t=\"pfH\">About you</h2>\n    <div class=\"setcard setonly\" id=\"pfCardBio\">\n      <div class=\"setcard-h\">\n        <span class=\"setcard-ic\"><i class=\"ti ti-user-circle\"></i></span>\n        <div class=\"setcard-ht\"><span class=\"setcard-t\" data-t=\"pfBio\">About you</span></div>\n      </div>\n      <hr class=\"setcard-div\">\n      <div class=\"bioedit\" id=\"pfBioText\" data-bioedit spellcheck=\"false\">Financial Analyst with 8 years in Riyadh. I lead IFRS reporting and budgeting on SAP across business units and own the monthly close for a 40-person function. I built the rolling forecasts and variance analysis that cut our reporting time by a third. I am looking for a Senior Financial Analyst or FP&A role in Riyadh, Jeddah, or remote.</div>\n      <div class=\"biohint\"><i class=\"ti ti-pencil\"></i> <span data-t=\"pfBioS\">Tap the text to edit it. Employers read this first, and it goes out on every application.</span></div>\n    </div>\n    <div class=\"setcard setonly\" id=\"pfCardPhoto\">\n      <div class=\"setcard-h\">\n        <span class=\"setcard-ic\"><i class=\"ti ti-camera\"></i></span>\n        <div class=\"setcard-ht\"><span class=\"setcard-t\" data-t=\"phT\">Professional photo</span></div>\n        <span class=\"setcard-opt\" data-t=\"phOpt\">optional</span>\n      </div>\n      <hr class=\"setcard-div\">\n      <div class=\"photorow\">\n        <div class=\"photoav\" data-photoav><i class=\"ti ti-user\"></i><span class=\"ok\"><i class=\"ti ti-check\"></i></span></div>\n        <div class=\"photox\"><b data-photolab data-t=\"phHint\">A clear headshot on a plain background</b><span data-photosub data-t=\"phHint2\">Some employers in Saudi ask for one. You can add it any time.</span></div>\n      </div>\n      <div class=\"photoacts\">\n        <button class=\"btn btn-o\" data-photoadd><i class=\"ti ti-upload\"></i> <span data-photobtn data-t=\"phAdd\">Upload a photo</span></button>\n        <button class=\"btn btn-o\" data-photodel style=\"display:none;flex:none\"><i class=\"ti ti-trash\"></i></button>\n      </div>\n    </div>\n    <div class=\"setcard\">\n      <div class=\"setcard-h\">\n        <span class=\"setcard-ic\"><i class=\"ti ti-id-badge-2\"></i></span>\n        <div class=\"setcard-ht\"><span class=\"setcard-t\" data-t=\"pfStatus\">Employment status</span></div>\n      </div>\n      <hr class=\"setcard-div\">\n      <div class=\"chipgrid\">\n        <div class=\"chips\">\n          <button class=\"chip on\" data-pfemp=\"employed\"><span data-t=\"pfEmployed\">Employed</span></button>\n          <button class=\"chip\" data-pfemp=\"unemployed\"><span data-t=\"pfUnemployed\">Unemployed</span></button>\n        </div>\n      </div>\n    </div>\n    <div class=\"cvfill\" id=\"pfImmediate\" style=\"display:none;border-color:#D9DCFB;background:linear-gradient(180deg,#F5F6FF,#fff)\">\n      <i class=\"ti ti-bolt\" style=\"color:var(--persian)\"></i>\n      <div class=\"cx\"><b data-t=\"pfImmT\">You can start immediately</b><span data-t=\"pfImmS\">Not being in a role is an advantage here. We say available immediately on every application, which employers filter for.</span></div>\n    </div>\n    <div class=\"setcard\" id=\"pfCardNotice\">\n      <div class=\"setcard-h\">\n        <span class=\"setcard-ic\"><i class=\"ti ti-clock-hour-4\"></i></span>\n        <div class=\"setcard-ht\"><span class=\"setcard-t\" data-t=\"pfNotice\">Notice period</span></div>\n        \n      </div>\n      <hr class=\"setcard-div\">\n      <div class=\"chipgrid\">\n        <div class=\"noticeman\" id=\"pfNoticeMan\">\n          <input class=\"inp\" id=\"pfNoticeNum\" data-pfreqnum=\"notice\" inputmode=\"numeric\" data-t-ph=\"pfNManPh\" placeholder=\"45\">\n          <span class=\"noticeunit\" data-t=\"pfUnitDays\">days</span>\n        </div>\n      </div>\n    </div>\n    <div class=\"setcard\" id=\"ob6PfBasics\">\n      <div class=\"setcard-h\">\n        <span class=\"setcard-ic\"><i class=\"ti ti-user\"></i></span>\n        <div class=\"setcard-ht\"><span class=\"setcard-t\" data-t=\"pfBasics\">Basics</span></div>\n      </div>\n      <hr class=\"setcard-div\">\n      <div class=\"chipgrid\" style=\"display:block\" id=\"ob6PfBasicsIn\"></div>\n    </div>\n    <div class=\"setcard\" id=\"ob6PfEeo\" style=\"display:none\">\n      <div class=\"setcard-h\">\n        <span class=\"setcard-ic\"><i class=\"ti ti-users\"></i></span>\n        <div class=\"setcard-ht\"><span class=\"setcard-t\" data-t=\"ob6Eeo\">Voluntary self-identification</span></div>\n        <span class=\"setcard-opt\" data-t=\"phOpt\">optional</span>\n      </div>\n      <hr class=\"setcard-div\">\n      <div class=\"chipgrid\" style=\"display:block\" id=\"ob6PfEeoIn\"></div>\n    </div>\n    <div class=\"setcard\" id=\"pfCardEng\">\n      <div class=\"setcard-h\">\n        <span class=\"setcard-ic\"><i class=\"ti ti-language\"></i></span>\n        <div class=\"setcard-ht\"><span class=\"setcard-t\" data-t=\"pfEng\" id=\"ob6PfEngT\">English level</span></div>\n      </div>\n      <hr class=\"setcard-div\">\n      <div class=\"chipgrid\">\n        <div class=\"chips\" data-pfreq=\"eng\" data-pfcv=\"1\">\n          <button class=\"chip\"><span data-t=\"pfEngBasic\">Basic</span></button>\n          <button class=\"chip\"><span data-t=\"pfEngInt\">Intermediate</span></button>\n          <button class=\"chip on\"><span data-t=\"pfEngAdv\">Advanced</span></button>\n          <button class=\"chip\"><span data-t=\"pfEngFluent\">Fluent</span></button>\n        </div>\n      </div>\n      <div id=\"ob6PfLang2\"></div>\n    </div>\n    <div class=\"setcard\" id=\"ob6PfSal\">\n      <div class=\"setcard-h\">\n        <span class=\"setcard-ic\"><i class=\"ti ti-coin\"></i></span>\n        <div class=\"setcard-ht\"><span class=\"setcard-t\" data-t=\"pfSalary\">Salary, SAR a month</span></div>\n      </div>\n      <hr class=\"setcard-div\">\n      <div class=\"chipgrid\" id=\"pfSalGrid\" style=\"display:grid;grid-template-columns:1fr 1fr;gap:10px\"></div>\n    </div>\n  </div>\n  <div class=\"cta\"><button class=\"btn btn-b dis\" id=\"pfCtaBtn\" data-go=\"aboutYou\"><span data-t=\"pfCta\">Save and continue</span></button></div>\n</section>",
